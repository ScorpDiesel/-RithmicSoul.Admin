@using RithmicSoul.Models.Survey.Dtos;

<MudDialog>
    <DialogContent>
        <MudForm>
            <MudTextField T="string" Label="QuestionText" Class="mb-8" @bind-Value="@_dto.QuestionText" Required></MudTextField>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; }

    private SurveyQuestionDto _dto = new();

    void Save()
    {
        MudDialog.Close(DialogResult.Ok(_dto));
    }

    void Cancel() => MudDialog.Cancel();
}