@page "/surveys"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using RithmicSoul.Models.Survey.Dtos

<PageTitle>Surveys</PageTitle>
@*<AuthorizeView>
    <NotAuthorized>
        <a href="authentication/login">Login In</a>
    </NotAuthorized>
    <Authorized>*@
<MudContainer Class="mt-16 mb-16" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudGrid Justify="Justify.FlexStart" Spacing="1">
        <MudItem xs="3">
            <MudGrid>
                <MudItem xs="10">
                    <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                        <MudList Clickable="true">
                            <MudListItem Text="Credit Survey" Icon="@Icons.Material.Filled.Add" OnClick="@NewSurvey" />
                            <MudListItem Text="Edit Survey" Icon="@Icons.Material.Filled.Edit" OnClick="@SelectSurveyDialogAsync" />
                            <MudListItem Text="Delete Survey" Icon="@Icons.Material.Filled.Delete" />
                        </MudList>
                    </MudPaper>
                </MudItem>
            </MudGrid>
            <MudGrid>
                <MudItem xs="10">
                    <MudStack>
                        <MudPaper Elevation="2" Class="pa-4 mt-8" Style="height: 600px">
                            <MudText Typo="Typo.h6" Class="pb-10">Console</MudText>
                            <MudItem Style="height: 480px;overflow-y: auto;white-space: pre-line;">

                            </MudItem>
                        </MudPaper>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="9">
            <MudGrid>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; overflow-y: auto">
                                <RsDataGrid T="AuthoredSurveyDto"
                                    Items="@_authoredSurveys"></RsDataGrid>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <!-- Adinkra Symbol Survey -->
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>
@*    </Authorized>
</AuthorizeView>
*@
