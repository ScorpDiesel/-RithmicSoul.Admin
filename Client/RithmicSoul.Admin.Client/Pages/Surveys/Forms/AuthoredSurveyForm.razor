@page "/SurveyForm"

@using RithmicSoulDatabaseLibrary.Interfaces
@using RithmicSoul.Models.Survey.Dtos
@using RithmicSoul.Admin.Client.Services
@using RithmicSoul.Admin.Client.Shared.Components
@inherits AuthoredSurveyFormBase
@inject IService<SurveyTypeDto> SurveyTypeService
@inject IService<SurveyQuestionDto> SurveyQuestionService
@inject IService<QuestionTypeDto> QuestionTypeService




<MudContainer Class="mt-4" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudGrid>
        <MudItem xs="5">
            <MudPaper Elevation="25" Class="mb-16">
                <MudToolBar>
                    <MudIconButton Size="Size.Large" Icon="@Icons.Material.Outlined.Cancel" OnClick="@Cancel" />
                    <MudIconButton Size="Size.Large" Icon="@Icons.Material.Outlined.Save" OnClick="@Save" />
                </MudToolBar>
            </MudPaper>
            <MudPaper Class="pa-10">
                <MudForm @ref="_form" ReadOnly="false">
                    <MudTextField T="string" Label="Survey Name" Required="true" RequiredError="Survey Name is required!" />
                    <MudTextField T="string" Label="Survey Description" Required="true" RequiredError="Survey Description is required!" Class="mt-16" />
                    <MudGrid>
                        <MudItem xs="12">
                            <MudStack Row="true" Class="mt-8" AlignItems="AlignItems.Center">
                            <MudSelect T="int?" Required Margin="@Margin.Dense" Variant="Variant.Outlined" Label="Survey Type" AnchorOrigin="Origin.BottomCenter"
                                       Style="width: 100px">
                                @if (_surveyTypes == null)
                                {
                                    return;
                                }
                                @foreach (var st in _surveyTypes)
                                {
                                    <MudSelectItem T="int?" Value="@st.SurveyTypeId">@st.SurveyTypeName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSpacer/>
                                <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                                <MudText>Add/Remove Questions</MudText>
                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.AddCircle" OnClick="@IncrementQuantity"/>
                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.DoNotDisturbOn" OnClick="@DecrementQuantity"/>
                            </MudStack>
                            </MudStack>
                        </MudItem>
                    </MudGrid>

                    <MudPaper Class="pa-4 mt-8" Elevation="3" Outlined="true">
                        <MudText Typo="Typo.h6" Class="pb-10">Survey Questions</MudText>
                        <div style="height: 680px; overflow-y: scroll;">

                            @for (var q = 1; q <= _questionQuantity; q++)
                            {
                                var index = q;
                                <MudPaper Class="pa-4 mt-8" Outlined="true">
                                    <MudText Typo="Typo.h6" Class="mb-5">@($"Question #{index}")</MudText>
                                        <MudGrid>
                                            <MudItem xs="3">
                                                <MudText></MudText> @*TODO: Get the quantity type name associated with the selected survey question*@
                                            </MudItem>
                                        <MudItem xs="9">
                                            <MudSelect T="int?" Required Margin="@Margin.Dense" Variant="Variant.Outlined" Label="Survey Question" AnchorOrigin="Origin.BottomCenter">
                                            @if (_surveyQuestions == null)
                                                {
                                                    return;
                                                }
                                                @foreach (var sq in _surveyQuestions)
                                                {
                                                    <MudSelectItem T="int?" Value="@sq.QuestionId">@sq.QuestionText</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <div>
                                            </div>
                                        </MudItem>
                                        @*@if (selectedType is not null)
                                    {
                                    <div class="border border-primary my-1 p-1">
                                    <DynamicComponent Type="@selectedType" />
                                    </div>
                                    }*@
                                    </MudGrid>
                                </MudPaper>
                            }
                        </div>
                    </MudPaper>
                    @*<div class="d-flex align-center justify-space-between">
                    <MudCheckBox T="bool" Required="true" RequiredError="You must agree" Label="I agree!" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!success)" Class="ml-auto">Register</MudButton>
                    </div>*@
                </MudForm>
            </MudPaper>
            @*<MudPaper Class="pa-4 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DisableElevation="true" OnClick="@(()=>form.Validate())">Validate</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" DisableElevation="true" OnClick="@(()=>form.Reset())" Class="mx-2">Reset</MudButton>
            <MudButton Variant="Variant.Filled" DisableElevation="true" OnClick="@(()=>form.ResetValidation())">Reset Validation</MudButton>
            </MudPaper>*@
        </MudItem>
        @*<MudItem xs="12" sm="5">
        <MudPaper Class="pa-4 mud-height-full">
        <MudText Typo="Typo.subtitle2">@($"Errors ({errors.Length})")</MudText>
        @foreach (var error in errors)
        {
        <MudText Color="@Color.Error">@error</MudText>
        }
        </MudPaper>
        </MudItem>*@
    </MudGrid>
</MudContainer>





@code {
    private MudForm _form;
    private IEnumerable<SurveyTypeDto> _surveyTypes;
    private IEnumerable<SurveyQuestionDto> _surveyQuestions;
    private IEnumerable<QuestionTypeDto> _questionTypes;
    private int _questionQuantity = 4;
    private List<Type?> _selectedTypeList;
    private Dictionary<string, Type> _selectedQuestionTypeDict;

    protected override async Task OnInitializedAsync()
    {
        _surveyTypes = await SurveyTypeService.GetAllAsync();
        _surveyQuestions = await SurveyQuestionService.GetAllAsync();
        _questionTypes = await QuestionTypeService.GetAllAsync();
        //_selectedQuestionTypeDict["Rating"] = typeof(RatingComponent);
        //_selectedQuestionTypeDict["Multiple Choice"]
        //_selectedQuestionTypeDict["Checkbox"]
        //_selectedQuestionTypeDict["Likert Scale"]
        //_selectedQuestionTypeDict["Demographic"]
    }

    void IncrementQuantity()
    {
        _questionQuantity = _questionQuantity < 10 ? ++_questionQuantity : _questionQuantity;
    }


    void DecrementQuantity()
    {
        _questionQuantity = _questionQuantity > 4 ? --_questionQuantity : _questionQuantity;
    }
}
