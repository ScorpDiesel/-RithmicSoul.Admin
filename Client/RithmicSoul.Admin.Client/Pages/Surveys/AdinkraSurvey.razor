@page "/surveys/adinkra"

<PageTitle>Adinkra Survey</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    @if (CurrentSymbols is null)
    {
        <MudItem style="text-align: center; vertical-align: middle;">
            <MudText Typo="Typo.h4">Loading...</MudText>
        </MudItem>
    }
    else
    {
        <MudItem style="margin: 40px 0; display: flex; flex-direction: row;">
            <MudText Typo="Typo.h4">Please select the Adinkra symbols you like by clicking the</MudText>
            <MudIcon Style="margin-left: 10px" Size="Size.Large" Icon="@Icons.Material.Filled.Favorite" />
        </MudItem>
        <div style="text-align: right">
            <MudButton StartIcon="@Icons.Material.Filled.NavigateBefore" OnClick="@PreviousPage" Disabled="@(!HasPreviousPage)">Previous</MudButton>
            <MudButton EndIcon="@Icons.Material.Filled.NavigateNext" OnClick="@NextPage" Disabled="@(!HasNextPage)">Next</MudButton>
        </div>
        <MudGrid>

            @foreach (var symbol in CurrentSymbols)
            {
                <MudItem xs="12" sm="6" md="3" lg="2" xl="2">
                    <AdinkraSymbolCard ImgSrc="@symbol.ImageBase64MimeTypeDataString"
                       AudioSrc="@symbol.AudioBase64MimeTypeDataString"
                       SymbolName="@symbol.SymbolName" SymbolMeaning="@symbol.SymbolMeaning"
                       SymbolTranslation="@symbol.SymbolTranslation"
                       SymbolId="@symbol.SymbolId"
                       SymbolLikes="@_symbolLikes"
                       OnSymbolClicked="@(isSelected => TallySymbolLikes(isSelected, symbol.SymbolId))" />
                </MudItem>
            }
        </MudGrid>
        <div style="text-align: right">
            <MudButton StartIcon="@Icons.Material.Filled.NavigateBefore" OnClick="@PreviousPage" Disabled="@(!HasPreviousPage)">Previous</MudButton>
            <MudButton EndIcon="@Icons.Material.Filled.NavigateNext" OnClick="@NextPage" Disabled="@(!HasNextPage)">Next</MudButton>
        </div>
    }
</MudContainer>

