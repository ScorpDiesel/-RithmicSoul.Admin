@inherits SurveyTablesBase
@page "/surveys"

@using RithmicSoul.Models.Survey.Dtos;
@using RithmicSoul.Admin.Client.Enums
@using RithmicSoul.Admin.Client.Pages.Surveys.Dialogs

<PageTitle>Surveys</PageTitle>

<MudContainer Class="mt-16" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudGrid Justify="Justify.FlexStart" Spacing="1">
        <MudItem xs="2">
            <MudGrid>
                <MudItem xs="10">
                    <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                        <MudList Clickable="true">
                            <MudListItem Text="Credit Survey" Icon="@Icons.Material.Filled.Add" />
                            <MudListItem Text="Edit Survey" Icon="@Icons.Material.Filled.Edit" />
                            <MudListItem Text="Delete Survey" Icon="@Icons.Material.Filled.Delete" />
                            @*<MudDivider />
                            <MudListItem Text="Trash" />
                            <MudListItem Text="Spam" />*@
                        </MudList>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="10">
            <MudGrid>
                <MudItem xs="12" sm="11">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                <MudText Typo="Typo.h6">Authored Surveys</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="7">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <MudDataGrid Items="@Surveys" T="SurveyDto" Hover="true" FixedHeader="true" Style="height: 560px;"
                                                     EditMode="DataGridEditMode.Form" CommittedItemChanges="@UpdateRecordAsync" CanceledEditingItem="@ResetRowHighlight"
                                                     RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true"
                                                     Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="MudGridSurvey">
                                            <ToolBarContent>
                                                <MudText Typo="Typo.h6">Table: @SurveyTableName</MudText>
                                                <MudSpacer />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await CreateAsync<SurveyDto, NewSurveyDialog>(); })" />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await RefreshAsync(EntityType.Survey); })" />
                                            </ToolBarContent>
                                            <Columns>
                                                <PropertyColumn Property="q => q.SurveyId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.SurveyTypeId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.SurveyName" />
                                                <PropertyColumn Property="q => q.SurveyDescription" />
                                                <PropertyColumn Property="q => q.DateCreated" IsEditable="false" />
                                                <TemplateColumn Hidden="false" CellClass="d-flex justify-space-around">
                                                    <CellTemplate>
                                                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await EditContextAsync(context); })" />
                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="async () => { await DeleteAsync(context.Item, context.Item.SurveyId); }" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            </Columns>
                                            <PagerContent>
                                                <MudDataGridPager T="SurveyDto" DisableRowsPerPage="true" />
                                            </PagerContent>
                                        </MudDataGrid>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <MudDataGrid Items="@SurveyQuestionnaires" T="SurveyQuestionnaireDto" Hover="true" FixedHeader="true" Style="height: 560px;"
                                                     EditMode="DataGridEditMode.Form" CommittedItemChanges="@UpdateRecordAsync" CanceledEditingItem="@ResetRowHighlight"
                                                     RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true"
                                                     Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="MudGridSurveyQuestionnaire">
                                            <ToolBarContent>
                                                <MudText Typo="Typo.h6">Table: @SurveyQuestionnaireTableName</MudText>
                                                <MudSpacer />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await CreateAsync<SurveyQuestionnaireDto, NewSurveyQuestionnaireDialog>(); })" />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await RefreshAsync(EntityType.SurveyQuestionnaire); })" />
                                            </ToolBarContent>
                                            <Columns>
                                                <PropertyColumn Property="q => q.QuestionnaireId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.QuestionTypeId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.SurveyQuestionId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.SurveyId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.DateCreated" IsEditable="false" />
                                                <TemplateColumn Hidden="false" CellClass="d-flex justify-space-around">
                                                    <CellTemplate>
                                                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await EditContextAsync(context); })" />
                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="async () => { await DeleteAsync(context.Item, context.Item.QuestionnaireId); }" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            </Columns>
                                            <PagerContent>
                                                <MudDataGridPager T="SurveyQuestionnaireDto" DisableRowsPerPage="true" />
                                            </PagerContent>
                                        </MudDataGrid>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; ">
                                        <MudDataGrid Items="@SurveyQuestions" T="SurveyQuestionDto" Hover="true" FixedHeader="true" Style="height: 560px;"
                                                     EditMode="DataGridEditMode.Form" CommittedItemChanges="@UpdateRecordAsync" CanceledEditingItem="@ResetRowHighlight"
                                                     RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true"
                                                     Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="MudGridSurveyQuestion">
                                            <ToolBarContent>
                                                <MudText Typo="Typo.h6">Table: @SurveyQuestionTableName</MudText>
                                                <MudSpacer />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await CreateAsync<SurveyQuestionDto, NewSurveyQuestionDialog>(); })" />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await RefreshAsync(EntityType.SurveyQuestion); })" />
                                            </ToolBarContent>
                                            <Columns>
                                                <PropertyColumn Property="q => q.QuestionId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.QuestionText" />
                                                <TemplateColumn Hidden="false" CellClass="d-flex justify-space-around">
                                                    <CellTemplate>
                                                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await EditContextAsync(context); })" />
                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="async () => { await DeleteAsync(context.Item, context.Item.QuestionId); }" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            </Columns>
                                            <PagerContent>
                                                <MudDataGridPager T="SurveyQuestionDto" DisableRowsPerPage="true" />
                                            </PagerContent>
                                        </MudDataGrid>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="4">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <MudDataGrid Items="@RatingTypeQuestionTypes" T="RatingTypeQuestionTypeDto" Hover="true" FixedHeader="true" Style="height: 560px;"
                                                     EditMode="DataGridEditMode.Form" CommittedItemChanges="@UpdateRecordAsync" CanceledEditingItem="@ResetRowHighlight"
                                                     RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true"
                                                     Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="MudGridRatingTypeQuestionType">
                                            <ToolBarContent>
                                                <MudText Typo="Typo.h6">Table: @RatingTypeQestionTypeTableName</MudText>
                                                <MudSpacer />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await CreateAsync<RatingTypeQuestionTypeDto, NewRatingTypeQuestionTypeDialog>(); })" />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await RefreshAsync(EntityType.RatingTypeQuestionType); })" />
                                            </ToolBarContent>
                                            <Columns>
                                                <PropertyColumn Property="q => q.QuestionTypeId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.RatingTypeId" IsEditable="false" />
                                                <TemplateColumn Hidden="false" CellClass="d-flex justify-space-around">
                                                    <CellTemplate>
                                                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await EditContextAsync(context); })" />
                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="async () => { await DeleteAsync(context.Item, context.Item.RatingTypeQuestionTypeId); }" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            </Columns>
                                            <PagerContent>
                                                <MudDataGridPager T="RatingTypeQuestionTypeDto" DisableRowsPerPage="true" />
                                            </PagerContent>
                                        </MudDataGrid>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <MudDataGrid Items="@RatingTypes" T="RatingTypeDto" Hover="true" FixedHeader="true" Style="height: 560px;"
                                                     EditMode="DataGridEditMode.Form" CommittedItemChanges="@UpdateRecordAsync" CanceledEditingItem="@ResetRowHighlight"
                                                     RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true"
                                                     Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="MudGridRatingType">
                                            <ToolBarContent>
                                                <MudText Typo="Typo.h6">Table: @RatingTypeTableName</MudText>
                                                <MudSpacer />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await CreateAsync<RatingTypeDto, NewRatingTypeDialog>(); })" />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await RefreshAsync(EntityType.RatingType); })" />
                                            </ToolBarContent>
                                            <Columns>
                                                <PropertyColumn Property="q => q.RatingTypeId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.RatingTypeName" />
                                                <TemplateColumn Hidden="false" CellClass="d-flex justify-space-around">
                                                    <CellTemplate>
                                                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await EditContextAsync(context); })" />
                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="async () => { await DeleteAsync(context.Item, context.Item.RatingTypeId); }" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            </Columns>
                                            <PagerContent>
                                                <MudDataGridPager T="RatingTypeDto" DisableRowsPerPage="true" />
                                            </PagerContent>
                                        </MudDataGrid>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <MudDataGrid Items="@SurveyTypes" T="SurveyTypeDto" Hover="true" FixedHeader="true" Style="height: 560px;"
                                                     EditMode="DataGridEditMode.Form" CommittedItemChanges="@UpdateRecordAsync" CanceledEditingItem="@ResetRowHighlight"
                                                     RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true"
                                                     Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="MudGridSurveyType">
                                            <ToolBarContent>
                                                <MudText Typo="Typo.h6">Table: @SurveyTypeTableName</MudText>
                                                <MudSpacer />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await CreateAsync<SurveyTypeDto, NewSurveyTypeDialog>(); })" />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await RefreshAsync(EntityType.SurveyType); })" />
                                            </ToolBarContent>
                                            <Columns>
                                                <PropertyColumn Property="q => q.SurveyTypeId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.SurveyTypeName" />
                                                <TemplateColumn Hidden="false" CellClass="d-flex justify-space-around">
                                                    <CellTemplate>
                                                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await EditContextAsync(context); })" />
                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="async () => { await DeleteAsync(context.Item, context.Item.SurveyTypeId); }" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            </Columns>
                                            <PagerContent>
                                                <MudDataGridPager T="SurveyTypeDto" DisableRowsPerPage="true" />
                                            </PagerContent>
                                        </MudDataGrid>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; ">
                                        <MudDataGrid T="QuestionTypeDto" Items="@QuestionTypes" Hover="true" FixedHeader="true" Style="height: 560px;"
                                                     EditMode="DataGridEditMode.Form" CommittedItemChanges="@UpdateRecordAsync" CanceledEditingItem="@ResetRowHighlight"
                                                     RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true"
                                                     Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="MudGridQuestionType">
                                            <ToolBarContent>
                                                <MudText Typo="Typo.h6">Table: @QuestionTypeTableName</MudText>
                                                <MudSpacer />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await CreateAsync<QuestionTypeDto, NewQuestionTypeDialog>(); })" />
                                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await RefreshAsync(EntityType.QuestionType); })" />
                                            </ToolBarContent>
                                            <Columns>
                                                <PropertyColumn Property="q => q.QuestionTypeId" IsEditable="false" />
                                                <PropertyColumn Property="q => q.QuestionTypeName" />
                                                <TemplateColumn Hidden="false" CellClass="d-flex justify-space-around">
                                                    <CellTemplate>
                                                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await EditContextAsync(context); })" />
                                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="async () => { await DeleteAsync(context.Item, context.Item.QuestionTypeId); }" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            </Columns>
                                            <PagerContent>
                                                <MudDataGridPager T="QuestionTypeDto" DisableRowsPerPage="true" />
                                            </PagerContent>
                                        </MudDataGrid>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>

