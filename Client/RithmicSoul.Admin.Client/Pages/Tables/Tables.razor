@page "/tables"

@using RithmicSoul.Models.Survey.Dtos;
@using RithmicSoul.Admin.Client.Views.Dialogs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<PageTitle>Surveys</PageTitle>
@*<AuthorizeView>
    <NotAuthorized>
        <a href="authentication/login">Login In</a>
    </NotAuthorized>
    <Authorized>*@
<MudContainer Class="mt-16 mb-16" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudGrid Justify="Justify.FlexStart" Spacing="1">
        <MudItem xs="12">
            <MudGrid>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="8">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <RsDataGrid T="SurveyDto" ReturnIdOnInsert="true"
                                                    Items="@_surveys"
                                                    ApiService="@SurveyService" ColumnsToHide="new[] { 1, 2 }"></RsDataGrid>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <RsDataGrid T="SurveyQuestionnaireDto"
                                                    Items="@_surveyQuestionnaires"
                                                    CanGroup="true" GroupExpanded="false" GroupBy="SurveyName"
                                                    ApiService="@SurveyQuestionnaireService" ColumnsToHide="new[] { 1, 2, 3 }"></RsDataGrid>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; overflow-y: auto">
                                        <RsDataGrid T="SurveyQuestionDto"
                                                    Items="@_surveyQuestions"
                                                    CanCreate="true" CanDelete="true" CanEdit="true" TDialog="typeof(SurveyQuestionDialog)"
                                                    CanGroup="true" GroupExpanded="false" GroupBy="QuestionTypeName"
                                                    ApiService="@SurveyQuestionService" ColumnsToHide="new[] { 1, 2 }"></RsDataGrid>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; overflow-y: auto">
                                        <RsDataGrid T="QuestionChoiceDto"
                                                    Items="@_questionChoices"
                                                    TEditDialog="typeof(EditQuestionChoiceDialog)" TDialog="typeof(NewQuestionChoiceDialog)"
                                                    CanCreate="true" CanDelete="true" CanEdit="true"
                                                    ColumnsToHide="new[] { 1, 2 }"
                                                    CanGroup="true" GroupExpanded="false" ApiService="@QuestionChoiceService"
                                                    GroupBy="QuestionText" MultiSelection="true"></RsDataGrid>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 650px; overflow-y: auto">
                                        <RsDataGridWithDetailRow T="AdinkraSymbolDto" DetailRowColumns="new[] { 5, 6 }"
                                                                 Items="@_adinkraSymbols"
                                                                 TEditDialog="typeof(EditQuestionChoiceDialog)" TDialog="typeof(NewQuestionChoiceDialog)"
                                                                 CanCreate="true" CanDelete="true" CanEdit="true" ColumnsToHide="new[] { 1, 5, 6 }"
                                                                 ApiService="@AdinkraSymbolService">
                                            <DetailRowContent>

                                            </DetailRowContent>
                                        </RsDataGridWithDetailRow>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="4">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <RsDataGrid T="SurveyTypeDto"
                                                    Items="@_surveyTypes"
                                                    CanCreate="true" CanDelete="true" CanEdit="true" TDialog="typeof(SurveyTypeDialog)"
                                                    ApiService="@SurveyTypeService"></RsDataGrid>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; ">
                                        <RsDataGrid T="QuestionTypeDto"
                                                    Items="@_questionTypes"
                                                    CanCreate="true" CanDelete="true" CanEdit="true" TDialog="typeof(QuestionTypeDialog)"
                                                    ApiService="@QuestionTypeService"></RsDataGrid>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>
@*    </Authorized>
</AuthorizeView>
*@
