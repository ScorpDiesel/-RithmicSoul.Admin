@page "/tables"
@using RithmicSoul.Models.Survey.Dtos
@using RithmicSoul.Admin.Client.Views.Dialogs
@using RithmicSoul.Models.Survey.Dtos;
@using RithmicSoul.Admin.Client.Views.Dialogs

<PageTitle>Surveys</PageTitle>
@*<AuthorizeView>
    <NotAuthorized>
        <a href="authentication/login">Login In</a>
    </NotAuthorized>
    <Authorized>*@
<MudContainer Class="mt-16 mb-16" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudGrid Justify="Justify.FlexStart" Spacing="1">
        <MudItem xs="12">
            <MudGrid>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="8">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <RsDataGrid T="SurveyDto" ReturnIdOnInsert="true"
                                                    Items="@_surveys"
                                                    ApiAdminService="@SurveyService" ColumnsToHide="@_surveyColumnsToHide"/>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <RsDataGrid T="SurveyQuestionnaireDto"
                                                    Items="@_surveyQuestionnaires"
                                                    CanGroup="true" GroupExpanded="false" GroupBy="SurveyName"
                                                    ApiAdminService="@SurveyQuestionnaireService" ColumnsToHide="@_surveyQuestionnaireColumnsToHide"/>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; overflow-y: auto">
                                        <RsDataGrid T="SurveyQuestionDto"
                                                    Items="@_surveyQuestions"
                                                    CanCreate="true" CanDelete="true" CanEdit="true" TDialog="@_surveyQuestionDialogType"
                                                    CanGroup="true" GroupExpanded="false" GroupBy="QuestionTypeName"
                                                    ApiAdminService="@SurveyQuestionService" ColumnsToHide="@_surveyQuestionColumnsToHide"/>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; overflow-y: auto">
                                        <RsDataGrid T="QuestionChoiceDto"
                                                    Items="@_questionChoices"
                                                    TEditDialog="@_questionChoiceEditDialogType" TDialog="@_questionChoiceDialogType"
                                                    CanCreate="true" CanDelete="true" CanEdit="true"
                                                    ColumnsToHide="@_questionChoicesColumnsToHide"
                                                    CanGroup="true" GroupExpanded="false" ApiAdminService="@QuestionChoiceService"
                                                    GroupBy="QuestionText" MultiSelection="true"/>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 650px; overflow-y: auto">
                                        <RsDataGridWithDetailRow T="AdinkraSymbolDto"
                                             Items="@_adinkraSymbols"
                                             CanCreate="true" CanDelete="true" CanEdit="true" ColumnsToHide="@_adinkraSymbolColumnsToHide"
                                             ApiAdminService="@AdinkraSymbolService">
                                            <DetailRowContent>
                                                <RsAdinkraSymbolCardSmall Style="width: 400px; height: 410px" SymbolId="@context.SymbolId"/>
                                            </DetailRowContent>
                                        </RsDataGridWithDetailRow>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="4">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px;">
                                        <RsDataGrid T="SurveyTypeDto"
                                            Items="@_surveyTypes"
                                            CanCreate="true" CanDelete="true" CanEdit="true" TDialog="@_surveyTypeDialogType"
                                            ApiAdminService="@SurveyTypeService"></RsDataGrid>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4" Style="height: 600px; ">
                                        <RsDataGrid T="QuestionTypeDto"
                                            Items="@_questionTypes"
                                            CanCreate="true" CanDelete="true" CanEdit="true" TDialog="@_questionTypeDialogType"
                                            ApiAdminService="@QuestionTypeService"></RsDataGrid>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>
@*    </Authorized>
</AuthorizeView>
*@
