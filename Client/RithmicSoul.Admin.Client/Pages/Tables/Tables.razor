@page "/tables"
@using RithmicSoul.Models.Survey.Dtos
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Surveys</PageTitle>
<MudContainer Class="mt-16 mb-16" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudGrid Justify="Justify.FlexStart" Spacing="1">
        <MudItem xs="12">
            <MudGrid>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="8">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4">
                                        <RsDataGrid T="SurveyMetaDataDto" ReturnIdOnInsert="true"
                                                    Items="@_surveys"
                                                    TableColumnWidths="@_surveyMetaDataColumnWidths"
                                                    ApiService="@SurveyService" ColumnsToHide="@_surveyColumnsToHide"/>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4">
                                        <RsDataGrid T="SurveyQuestionnaireDto"
                                                    Items="@_surveyQuestionnaires"
                                                    TableColumnWidths="@_surveyQuestionnaireColumnWidths"
                                                    CanGroup="true" GroupExpanded="false" GroupBy="SurveyName"
                                                    ApiService="@SurveyQuestionnaireService" ColumnsToHide="@_surveyQuestionnaireColumnsToHide"/>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4">
                                        <RsDataGrid T="SurveyQuestionDto"
                                                    Items="@_surveyQuestions"
                                                    TableColumnWidths="@_surveyQuestionColumnWidths"
                                                    CanCreate="true" CanDelete="true" CanEdit="true" TDialog="@_surveyQuestionDialogType"
                                                    CanGroup="true" GroupExpanded="false" GroupBy="QuestionTypeName"
                                                    ApiService="@SurveyQuestionService" ColumnsToHide="@_surveyQuestionColumnsToHide"/>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4">
                                        <RsDataGrid T="QuestionChoiceDto"
                                                    Items="@_questionChoices"
                                                    TEditDialog="@_questionChoiceEditDialogType" TDialog="@_questionChoiceDialogType"
                                                    CanCreate="true" CanDelete="true" CanEdit="true"
                                                    ColumnsToHide="@_questionChoicesColumnsToHide"
                                                    TableColumnWidths="@_questionChoiceColumnWidths"
                                                    CanGroup="true" GroupExpanded="false" ApiService="@QuestionChoiceService"
                                                    GroupBy="QuestionText" MultiSelection="true"/>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4">
                                        <RsDataGridWithDetailRow T="AdinkraSymbolDto"
                                             Items="@_adinkraSymbols"
                                             TableColumnWidths="@_adinkraSymbolColumnWidths"
                                             CanCreate="true" CanDelete="false" CanEdit="true" ColumnsToHide="@_adinkraSymbolColumnsToHide"
                                             ApiService="@AdinkraSymbolService">
                                            <DetailRowContent>
                                                <RsAdinkraSymbolCardSmall Style="width: 400px; height: 410px" SymbolId="@context.SymbolId"/>
                                            </DetailRowContent>
                                        </RsDataGridWithDetailRow>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="4">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4">
                                        <RsDataGrid T="SurveyTypeDto"
                                            Items="@_surveyTypes" MultiSelection="true"
                                            CanCreate="true" CanDelete="true" CanEdit="true" TDialog="@_surveyTypeDialogType"
                                            ApiService="@SurveyTypeService"/>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudPaper Elevation="2" Class="pa-4">
                                        <RsDataGrid T="QuestionTypeDto"
                                            Items="@_questionTypes"
                                            CanCreate="true" CanDelete="true" CanEdit="true" TDialog="@_questionTypeDialogType"
                                            ApiService="@QuestionTypeService"/>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>
