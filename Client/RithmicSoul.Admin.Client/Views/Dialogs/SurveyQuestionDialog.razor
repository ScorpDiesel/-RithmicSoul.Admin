@using RithmicSoul.Models.Survey.Dtos;
@using RithmicSoulDatabaseLibrary.Interfaces
@using Microsoft.Extensions.Options
@using RithmicSoul.Admin.Client.Configuration
@using RithmicSoul.Models.Survey.Models
@using RithmicSoulDatabaseLibrary.Utilities

<MudDialog Style="Width: 400px;">
    <DialogContent>
        <MudForm>
            <MudSelect T="int" Required Margin="@Margin.Dense" Variant="Variant.Outlined" Label="@nameof(Model.QuestionTypeName)" AnchorOrigin="Origin.BottomCenter"
                       @bind-Value="@Model.QuestionTypeId" Style="mb-5" 
                       Converter="@ConvertIdToName">
                <MudSelectItem T="int" Value="0" Disabled="true">Select...</MudSelectItem>
                @if (_questionTypes == null)
                {
                    return;
                }
                @foreach (var sq in _questionTypes)
                {
                    <MudSelectItem T="int" Value="@sq.QuestionTypeId">@sq.QuestionTypeName</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Label="QuestionText" Class="mb-8" @bind-Value="@Model.QuestionText" FullWidth="true" 
                Lines="3" Required></MudTextField>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private IService<SurveyQuestionDto>? SurveyQuestionService { get; set; }
    [Inject] private ISnackbar? Snackbar { get; set; }
    [Inject] IOptions<AppSettings> AppSettingsOptions { get; set; }
    [Inject] IService<QuestionTypeDto> QuestionTypeService { get; set; }

    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public SurveyQuestionDto? Model { get; set; }
    [Parameter] public EventCallback OnOperationCompleted { get; set; }

    private string SurveyQuestionTableName = EntityUtility.GetTableName<SurveyQuestion>();
    private static IEnumerable<QuestionTypeDto> _questionTypes;
    private bool _isNewQuestion;
    private AppSettings _appSettings;

    protected override async Task OnInitializedAsync()
    {
        _isNewQuestion = Model is null;
        Model ??= new SurveyQuestionDto();
        _appSettings = AppSettingsOptions.Value;
        _questionTypes = await QuestionTypeService.GetAllAsync();
    }

    public MudBlazor.Converter<int, string> ConvertIdToName = new()
    {
        GetFunc = str => int.TryParse(str, out var id) ? id : 0,
        SetFunc = id => _questionTypes.FirstOrDefault(qt => qt.QuestionTypeId == id)?.QuestionTypeName ?? "Select..."
    };


    async Task SaveAsync()
    {
        bool isSaveSuccessful;
        if (_isNewQuestion)
        {
            isSaveSuccessful = await SurveyQuestionService?.InsertAsync(Model);
        }
        else
        {
            isSaveSuccessful = await SurveyQuestionService?.UpdateAsync(Model);
        }

        ShowSnackBar(isSaveSuccessful);
        await OnOperationCompleted.InvokeAsync(null);
        MudDialog.Close(DialogResult.Ok(true));
    }

    void Cancel() => MudDialog.Cancel();

    private void ShowSnackBar(bool isSuccessful)
    {
        Snackbar?.Clear();
        string message;
        if (isSuccessful)
        {
            message = _isNewQuestion ? string.Format(_appSettings.ItemCreatedSuccessMessageTemplate, SurveyQuestionTableName)
                : string.Format(_appSettings.ItemUpdatedSuccessMessageTemplate, SurveyQuestionTableName);

            Snackbar?.Add(message, Severity.Success);
        }
        else
        {
            message = _isNewQuestion ? string.Format(_appSettings.ItemCreatedFailureMessageTemplate, SurveyQuestionTableName)
                : string.Format(_appSettings.ItemUpdatedFailureMessageTemplate, SurveyQuestionTableName);

            Snackbar?.Add(message, Severity.Error);
        }
    }
}