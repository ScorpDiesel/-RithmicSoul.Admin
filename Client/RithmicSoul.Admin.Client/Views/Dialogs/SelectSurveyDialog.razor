@using RithmicSoulSharedLibrary.Extensions
<MudDialog Class="pa-5">
    <DialogContent>
        <MudSelect T="int" Required Margin="@Margin.Dense" Variant="Variant.Outlined" Label="@nameof(_model.SurveyName).SplitCamelCase()" AnchorOrigin="Origin.BottomCenter"
                   @bind-Value="@_model.SurveyId">
            <MudSelectItem T="int" Value="0" Disabled="true">Select...</MudSelectItem>
            @if (_surveys == null)
            {
                return;
            }
            @foreach (var st in _surveys)
            {
                <MudSelectItem T="int" Disabled="@(!st.IsActive && IsShowDialog)" Value="@st.SurveyId">@st.SurveyName</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@SelectSurvey">Select</MudButton>
    </DialogActions>
</MudDialog>