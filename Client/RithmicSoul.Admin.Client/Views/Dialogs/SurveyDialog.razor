@using RithmicSoul.Models.Survey.Dtos;
@using RithmicSoulDatabaseLibrary.Interfaces
@inject IService<SurveyTypeDto> SurveyTypeService

<MudDialog>
    <DialogContent>
        <MudForm>
            <MudSelect T="int?" Required Margin="@Margin.Dense" Variant="Variant.Outlined" Label="@nameof(Model.SurveyTypeName)" AnchorOrigin="Origin.BottomCenter"
                       @bind-Value="@Model.SurveyTypeId">
               @* <MudSelectItem T="int?" Value="0" Disabled="true">Select...</MudSelectItem>*@
                @if (_surveyTypes == null)
                {
                    return;
                }
                @foreach (var st in _surveyTypes)
                {
                    <MudSelectItem T="int?" Value="@st.SurveyTypeId">@st.SurveyTypeName</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Label="@nameof(Model.SurveyName)" Class="mb-8" @bind-Value="@Model.SurveyName" Required></MudTextField>
            <MudTextField T="string" Label="@nameof(Model.SurveyDescription)" Class="mb-8" @bind-Value="@Model.SurveyDescription" Required></MudTextField>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public SurveyDto? Model { get; set; }

    //public int? SelectedSurveyTypeId
    //{
    //    get => Model.SurveyTypeId == 0 ? null : Model.SurveyTypeId;
    //    set => Model.SurveyTypeId = value ?? 0;
    //}

    private IEnumerable<SurveyTypeDto>? _surveyTypes;

    protected override async Task OnInitializedAsync()
    {
        _surveyTypes = await SurveyTypeService.GetAllAsync();
        Model ??= new SurveyDto();
    }

    void Save()
    {
        Console.WriteLine(Model.SurveyTypeId);
        MudDialog.Close(DialogResult.Ok(Model));
    }

    void Cancel() => MudDialog.Cancel();
     
}