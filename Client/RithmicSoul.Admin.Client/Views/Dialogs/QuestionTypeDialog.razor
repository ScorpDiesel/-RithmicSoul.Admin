@using RithmicSoul.Models.Survey.Dtos;

<MudDialog>
    <DialogContent>
        <MudForm>
            <MudTextField T="string" Label="QuestionTypeName" Class="mb-8" @bind-Value="@Model.QuestionTypeName" Required></MudTextField>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public QuestionTypeDto? Model { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new QuestionTypeDto();
    }

    void Save()
    {
        MudDialog.Close(DialogResult.Ok(Model));
    }

    void Cancel() => MudDialog.Cancel();
}