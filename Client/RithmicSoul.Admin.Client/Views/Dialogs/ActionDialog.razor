<MudDialog Class="pa-5">
    <DialogContent>
        <div style="@Style">
            <MudText Style="white-space: pre-wrap;">@ContentText</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@CancelButtonText</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="@Close">@CloseButtonText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    MudDialogInstance MudDialog { get; set; }

    [Parameter] public string ContentText { get; set; }

    [Parameter] public string CloseButtonText { get; set; }

    [Parameter] public string CancelButtonText { get; set; }

    [Parameter] public string Style { get; set; }

    [Parameter] public Color Color { get; set; }

    void Close() => MudDialog.Close(DialogResult.Ok(true));

    void Cancel() => MudDialog.Cancel();
}