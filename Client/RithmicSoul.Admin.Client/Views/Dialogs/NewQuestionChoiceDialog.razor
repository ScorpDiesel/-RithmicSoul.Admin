<MudDialog Class="pa-4" Style="max-width: fit-content;">
    <DialogContent>
        <MudForm>
            <MudText Color="@_statusMessageColor" Class="mb-5" Typo="Typo.body2">@_statusMessage</MudText>
            <MudSelect T="int?" Required Margin="@Margin.Dense" Variant="Variant.Outlined" Label="@nameof(Model.QuestionText)" AnchorOrigin="Origin.BottomCenter"
                       @bind-Value="@Model.QuestionId" Style="Width: 1000px" TextChanged="@QuestionTypeChangeEvent">
                <MudSelectItem T="int?" Value="0" Disabled="true">Select...</MudSelectItem>
                @if (_surveyQuestions == null)
                {
                    return;
                }
                @foreach (var st in _surveyQuestions)
                {
                    <MudSelectItem T="int?" Value="@st.QuestionId">@st.QuestionText</MudSelectItem>
                }
            </MudSelect>
            <MudPaper Class="mt-4 mb-4 pa-4" Style="@_questionTypeNameVisibility" Outlined="true">
                <MudText>Question: @_questionText</MudText>
            </MudPaper>
            <MudText Style="@_questionTypeNameVisibility">Question Type: @_questionTypeName</MudText>
            <MudPaper Class="mt-4 pa-4" Style="@_choiceControlsVisibility" Outlined="true">
                <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Style="@_choiceControlsVisibility">
                    <MudText>Add Question Choices</MudText>
                    <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.AddCircle" OnClick="@AddQuestionChoice" />
                </MudStack>
                @foreach (var choice in Model.QuestionChoices.Select((value, index) => new { index, value }))
                {
                    var index = choice.index;
                    <MudPaper Class="mt-4 pa-4" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudStack Justify="Justify.FlexStart" Style="Width: 100%">
                                <MudTextField T="string" Label="Choice Text" Class="mb-8" @bind-Value="Model.QuestionChoices[index]" Required></MudTextField>
                                <MudTextField T="string" Label="Choice Example" Class="mb-8" @bind-Value="Model.QuestionExamples[index]"></MudTextField>
                            </MudStack>
                            <MudSpacer />
                            <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.DoNotDisturbOn" OnClick="@(() => { RemoveQuestionChoice(index); })" />
                        </MudStack>
                    </MudPaper>
                }
            </MudPaper>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>