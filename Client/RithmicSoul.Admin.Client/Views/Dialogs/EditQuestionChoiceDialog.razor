<MudDialog Class="pa-4" Style="max-width: fit-content;">
    <DialogContent>
        <RsLoadingSpinnerCard ShowContent="@_showContent" />
        <MudContainer Style="@_contentStyle">
            <MudForm>
                <MudPaper Class="mt-4 mb-4 pa-4" Outlined="true">
                    <MudText>Question: @Model.QuestionText</MudText>
                </MudPaper>
                <MudText>Question Type: @_questionTypeName</MudText>
                <MudPaper Class="mt-4 pa-4" Outlined="true">
                    <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
                        <MudText>Add Question Choices</MudText>
                        <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.AddCircle" OnClick="@AddQuestionChoice" />
                    </MudStack>
                    <MudPaper Class="mt-4 pa-4" Outlined="true">
                        @foreach (var choice in DtoList.Select((value, index) => new { index, value }))
                        {
                            var value = choice.value;
                            var index = choice.index;
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
                                <MudStack Row="true" Justify="Justify.Center" Style="Width: 100%" Class="pa-4">
                                    <MudTextField Class="mr-4" Lines="3" Variant="Variant.Outlined" T="string" Label="@nameof(Model.ChoiceText)" @bind-Value="@choice.value.ChoiceText" Required/>
                                    <MudTextField Lines="3" Variant="Variant.Outlined" T="string" Label="@nameof(Model.ChoiceExample)" @bind-Value="@choice.value.ChoiceExample"/>
                                </MudStack>
                                <MudSpacer />
                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.DoNotDisturbOn" OnClick="@(() => { RemoveQuestionChoice(index); })" />
                            </MudStack>
                        }
                    </MudPaper>
                </MudPaper>
            </MudForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <div class="mt-5" style="@_contentStyle">
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" OnClick="@SaveEditAsync">Save</MudButton>
        </div>
    </DialogActions>
</MudDialog>