<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <div style="width: 600px; height: 731px">
                @*<MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                <MudCardContent>
                    <MudSkeleton Width="30%" Height="42px;" />
                    <MudSkeleton Width="80%" />
                    <MudSkeleton Width="100%" />
                </MudCardContent>
                <MudCardActions>
                    <MudSkeleton Width="64px" Height="40px" Class="ml-2" />
                    <MudSkeleton Width="105px" Height="40px" Class="ml-3" />
            </MudCardActions>*@
                <div class="@(_isVisible ? "invisible" : "visible");centered-container">
                    <svg class="spinner" viewBox="0 0 50 50">
                        <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                    </svg>
                </div>
            </div>
        }
        else
        {
            <MudForm>
                <MudPaper Class="mt-4 mb-4 pa-4" Outlined="true">
                    <MudText>Question: @Model.QuestionText</MudText>
                </MudPaper>
                <MudText>Question Type: @_questionTypeName</MudText>
                <MudPaper Class="mt-4 pa-4" Outlined="true">
                    <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
                        <MudText>Add Question Choices</MudText>
                        <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.AddCircle" OnClick="@AddQuestionChoice" />
                    </MudStack>
                    @foreach (var choice in DtoList.Select((value, index) => new { index, value }))
                    {
                        var value = choice.value;
                        var index = choice.index;
                        <MudPaper Class="mt-4 pa-4" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudStack Justify="Justify.FlexStart" Style="Width: 100%">
                                    <MudTextField Lines="3" Variant="Variant.Outlined" T="string" Label="@nameof(Model.ChoiceText)" Class="mb-4" @bind-Value="@choice.value.ChoiceText" Required></MudTextField>
                                    <MudTextField Lines="5" Variant="Variant.Outlined" T="string" Label="@nameof(Model.ChoiceExample)" Class="mb-8" @bind-Value="@choice.value.ChoiceExample"></MudTextField>
                                </MudStack>
                                <MudSpacer/>
                                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.DoNotDisturbOn" OnClick="@(() => { RemoveQuestionChoice(index); })" />
                            </MudStack>
                        </MudPaper>
                    }
                </MudPaper>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <div class="@(_isVisible ? "invisible" : "visible")">
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@SaveEditAsync">Save</MudButton>
        </div>
    </DialogActions>
</MudDialog>