@inherits RsDataGridBase<T>
@using RithmicSoul.Models.Survey.Dtos
@using RithmicSoul.Admin.Client.Views.Dialogs
@using RithmicSoul.Admin.Core.Enums
@typeparam T

<RsLoadingSpinnerCard ShowContent="@_showContent" Style="height: 650px" />
<MudContainer Style="@_contentStyle"  MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudDataGrid Items="@Items" T="T" Hover="true" FixedHeader="true" Height="560px" Virtualize="true"
         EditMode="DataGridEditMode.Form" CommittedItemChanges="@(async item => { await UpdateItemAsync(item); })" CanceledEditingItem="@ResetRowHighlight"
         RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true" Filterable="@CanFilter" QuickFilter="@QuickFilter"
         FilterMode="DataGridFilterMode.Simple" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
         Groupable="@CanGroup" GroupExpanded="@GroupExpanded" MultiSelection="@MultiSelection"
         Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="thisDataGrid">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Table: @TableName</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="@_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true" Clearable="true"
                AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0 mr-8 mb-4"></MudTextField>
            @if (CanGroup)
            {
                @if (!GroupExpanded)
                {
                    <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.UnfoldMore" Class="mt-0" OnClick="@ExpandGroups" />
                }
                else
                {
                    <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.UnfoldLess" Class="mt-0" OnClick="@CollapseGroups" />
                }
            }
            @if (CanCreate)
            {
                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await ShowNewItemDialogAsync(); })" />
            }
            @if (CanDelete && thisDataGrid.MultiSelection && thisDataGrid.SelectedItems.Any())
            {
                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Delete" OnClick="@(async () => { await DeleteSelectedItemsAsync(); })" />
            }
            <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await GetAllItemsAsync(); })" />
        </ToolBarContent>
        <Columns>
            @if (MultiSelection)
            {
                <SelectColumn T="T" ShowInFooter="false" />
            }
            @if (Items is null)
            {
                return;
            }
            @foreach (var property in _properties.Select((value, index) => new { index, value }))
            {
                var value = property.value;
                var thisIndex = property.index + 1;
                if (ColumnsToHide is not null && ColumnsToHide.Contains(thisIndex))
                {
                    continue;
                }
                @CreateColumn(value)
               @* <PropertyColumn Property="x => x[value.Name]" Title="@value.Name" />*@
            }
            <TemplateColumn Hidden="@(!CanEdit && !CanDelete)" CellClass="d-flex justify-space-around">
                <CellTemplate>
                    @if (CanEdit)
                    {
                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await ShowEditItemDialogAsync(context.Item); })" />
                    }
                    @if (CanDelete)
                    {
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(async () => await DeleteSelectedItemsAsync(context.Item))" />
                    }
                </CellTemplate>
                @*<GroupTemplate>
                    @if (CanEdit)
                    {
                        <span>adslfasdfasdf asdf adfd</span>
                        @*<MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await ShowEditItemDialogAsync(context.Grouping.Key); })" />*@
                    @*}
                    @if (CanDelete)
                    {
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(async () => { await DeleteSelectedItemsAsync(); })" />
                    }
                </GroupTemplate>*@
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="T"/>
        </PagerContent>
    </MudDataGrid>
</MudContainer>