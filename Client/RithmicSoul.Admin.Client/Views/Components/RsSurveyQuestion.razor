<MudPaper Class="pa-4" Outlined="true">
    <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Class="pa-4">
        <MudText Class="@_questionClass" Typo="Typo.h6">@_questionNumberText</MudText>
        <MudText Typo="@QuestionTextTypography">@QuestionText</MudText>
    </MudStack>
    <MudStack Class="pa-4">
        <MudStack Class="pa-5">
            @{
                for (var q = 0; q < _choices.Count(); q++)
                {
                    var questionChoice = _choices.ElementAt(q);
                    var style = "none";
                    if (q == QuestionNumber)
                    {
                        style = "block";
                    }

                    <div style="display:@style">
                        @CreateRenderFragment(questionChoice)
                    </div>
                }
            }
        </MudStack>
    </MudStack>
</MudPaper>