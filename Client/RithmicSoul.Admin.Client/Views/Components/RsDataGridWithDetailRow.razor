@inherits RsDataGridBase<T>
@typeparam T

@if (Items is null || !Items.Any())
{
    <MudText Typo="Typo.h2" style="vertical-align: middle;text-align: center">
        No data
    </MudText>
}
else
{
    <MudDataGrid Items="@Items" T="T" Hover="true" FixedHeader="true" Style="height: 560px;"
                 EditMode="DataGridEditMode.Form" CommittedItemChanges="@UpdateItemAsync" CanceledEditingItem="@ResetRowHighlight"
                 RowStyleFunc="@((item, index) => GetRowHighlight(item, index))" Striped="true"
                 Groupable="@CanGroup" GroupExpanded="@GroupExpanded" MultiSelection="@MultiSelection"
                 Dense="true" EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" @ref="thisDataGrid">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Table: @TableName</MudText>
            <MudSpacer/>
            @if (CanGroup)
            {
                @if (!_isExpanded)
                {
                    <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.UnfoldMore" Class="mt-0" OnClick="@ExpandGroups"/>
                }
                else
                {
                    <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.UnfoldLess" Class="mt-0" OnClick="@CollapseGroups"/>
                }
            }
            @if (CanCreate)
            {
                <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Add" Class="mt-0" OnClick="@(async () => { await ShowNewItemDialogAsync(); })"/>
            }
            <MudIconButton Size="@Size.Large" Icon="@Icons.Material.Filled.Refresh" Class="mt-0" OnClick="@(async () => { await UpdateItemsAsync(); })"/>
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="T"/>
            @if (MultiSelection)
            {
                <SelectColumn T="T" ShowInFooter="false"/>
            }
            @if (Items is null)
            {
                return;
            }
            @foreach (var property in _properties.Select((value, index) => new { index, value }))
            {
                var value = property.value;
                var thisIndex = property.index + 1;
                if (ColumnsToHide is not null && ColumnsToHide.Contains(thisIndex))
                {
                    continue;
                }
                @CreateColumn(value)
            }
            <TemplateColumn Hidden="false" CellClass="d-flex justify-space-around">
                <CellTemplate>
                    @if (CanEdit)
                    {
                        <MudIconButton Class="mr-3" Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(async () => { await ShowEditItemDialogAsync(context.Item); })"/>
                    }
                    @if (CanDelete)
                    {
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(async () => { await DeleteAsync(context.Item); })"/>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            @if (DetailRowContent is not null)
            {
                @DetailRowContent(context.Item)
            }
        }
        </ChildRowContent>
        <PagerContent>
            <MudDataGridPager T="T" DisableRowsPerPage="true"/>
        </PagerContent>
    </MudDataGrid>
}