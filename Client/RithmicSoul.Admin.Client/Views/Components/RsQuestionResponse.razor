<MudCard Class="pa-4 pl-16" Style="@Style" @onmouseover="@CardElevationUp" @onmouseout="@CardElevationDown" Elevation="@_elevation">
    <MudText Style="@(_showNoAnswersMessage ? "" : "display:none")" Typo="Typo.h6">No answers for this question</MudText>
    <div style="@(!_showNoAnswersMessage ? "" : "display:none")">
        <MudText>
            @SurveyQuestion
        </MudText>
        <MudCardContent Class="">
            <hr/>
            <div class="">
                @foreach (var answer in _answers)
                {
                    <p>@answer</p>
                }
            </div>
        </MudCardContent>
    </div>
</MudCard>