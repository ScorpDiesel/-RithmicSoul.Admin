<MudCard Style="@Style" @onmouseover="@CardElevationUp" @onmouseout="@CardElevationDown" Elevation="@_elevation">
    <div style="@_loadingStyle" class="centered-container">
        <svg class="spinner" viewBox="0 0 50 50">
            <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
        </svg>
    </div>
    <div style="@_contentStyle">
        <div style="text-align: center;">
            <img src="@_imgSrcUrl" Width="300" Style="padding:40px 40px 20px;" alt="@SymbolId"
                 @onload="@DisplayContent"/>
        </div>
        <MudCardContent>
            <hr style="margin-bottom: 20px"/>
            <div style="text-align: center;">
                <audio controls="controls" src="@_audioSrcUrl"></audio>
            </div>
        </MudCardContent>
    </div>
</MudCard>