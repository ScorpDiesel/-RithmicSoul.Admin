<div style="@_style" class="centered-container">
    <svg class="spinner" viewBox="0 0 50 50">
        <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
    </svg>
</div>

@code
{
    [Parameter] public string Style { get; set; }
    [Parameter] public bool ShowContent
    {
        get => _showContent;
        set
        {
            _showContent = value;
            SetCardStyle(value);
        }
    }

    private bool _showContent;
    private string _style;

    protected override void OnInitialized()
    {
        _style = Style;
    }

    private void SetCardStyle(bool value) => _style = value ? "display:none" : string.Empty;
}
